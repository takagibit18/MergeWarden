# Reserved integration settings. No command currently loads model credentials.
# Do not point TRUSTED_STATE_DIR into an untrusted reviewed checkout.
MERGEWARDEN_TRUSTED_STATE_DIR=
MERGEWARDEN_MODEL_PROVIDER=
MERGEWARDEN_MODEL_ID=
# OFF by default. Shadow must not change tools, prompts, or conclusions.
MERGEWARDEN_ADVISOR_MODE=off
# Only used after the Jev adapter is implemented and consented to.
TYPESAFE_API_KEY=
# Optional override for the grammar fixture; must match grammars/python.lock.json.
MERGEWARDEN_PYTHON_GRAMMAR_WASM=
